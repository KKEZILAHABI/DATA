# Local .terraform directories (contains the downloaded Docker provider)
**/.terraform/*

# .tfstate files (contains sensitive data and exact infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore any files holding passwords or variables (if you make them later)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

terminallogs.txt
startup.txt

# Ignore .vscode settings (if you use Visual Studio Code)
.vscode/

# Ignore .metadata directory (if it exists, as it may contain IDE-specific metadata)
.metadata/

# Ignore the CH_Sim directory (if it contains generated files or logs)
CH_Sim/

#Unnecessary files
Example Workflows/